# GitHub personal access token with "models: read" permission.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=your-token-here

# Which GitHub Models catalog model to use for generation
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Where the from-scratch vector index (TF-IDF matrix + vectorizer + metadata) is persisted
VECTOR_INDEX_DIR=data/vector_index
