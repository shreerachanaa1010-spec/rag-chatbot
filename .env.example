# Gemini API key.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Which Gemini model to use for generation
GEMINI_MODEL=gemini-3.6-flash

# Where the local LangChain FAISS index is persisted
VECTOR_INDEX_DIR=data/vector_index

# Hugging Face sentence-transformers model used for semantic retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# SMTP settings for the explicit "Send case to HR" action
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=hr-policy-desk@example.com
HR_EMAIL_TO=hr-team@example.com

# Security and operational settings. Leave HR_API_KEY empty only for local development.
HR_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVIEW_DB_PATH=data/review_cases.sqlite3
LOG_LEVEL=INFO
